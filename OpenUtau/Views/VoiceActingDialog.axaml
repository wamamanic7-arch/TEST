<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.VoiceActingDialog"
        x:DataType="vm:VoiceActingViewModel"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource voiceacting.caption}"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Design.DataContext>
    <vm:VoiceActingViewModel/>
  </Design.DataContext>
  <!-- One panel per track: what the character sounds like, how it talks, and what it plays through.
       Every tab starts with a switch and one sentence saying what it does; every control says what it changes
       in plain words, with more in its tooltip. -->
  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="TextBlock.end">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.6"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,8,14,10"/>
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#33F2A33A"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{DynamicResource button.on}"/>
      <Setter Property="OffContent" Value="{DynamicResource button.off}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- Tiles: a grid of choices, each with a name and what it sounds like. -->
    <Style Selector="ListBox.tiles">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
      <!-- The app's list items are one line high; tiles have two. -->
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="TextBlock.tileTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.tileText">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <StackPanel DockPanel.Dock="Top" Margin="20,14,20,6" Spacing="2">
      <TextBlock Classes="heading" Text="{Binding TrackName}"/>
      <TextBlock Classes="hint" Text="{DynamicResource voiceacting.intro}"/>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="20,10,20,16">
      <TextBlock Classes="hint" VerticalAlignment="Center" Text="{DynamicResource voiceacting.live}"/>
      <Button Grid.Column="1" Name="CancelButton" Content="{DynamicResource button.cancel}" MinWidth="80"
              Margin="12,0,8,0" Click="OnCancelClicked"/>
      <Button Grid.Column="2" Name="OkButton" Content="{DynamicResource button.ok}" MinWidth="80"
              Classes="accent" Click="OnOkClicked"/>
    </Grid>

    <TabControl Name="Tabs" Margin="12,0" SelectedIndex="{Binding Page}">

      <!-- Character: the emotion, and speech melody. -->
      <TabItem Name="CharacterTab" Header="{DynamicResource voiceacting.tab.character}">
        <StackPanel Margin="8,10,8,4" Spacing="10">
          <Border Classes="notice" IsVisible="{Binding !CanSpeak}">
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource voiceacting.nosinger}"/>
          </Border>
          <StackPanel Spacing="10" IsEnabled="{Binding CanSpeak}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Classes="title" Text="{DynamicResource voiceacting.character}"/>
                <TextBlock Classes="hint" Text="{DynamicResource voiceacting.character.desc}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Name="SpeechSwitch" IsChecked="{Binding SpeechOn}"/>
            </Grid>
            <ListBox Classes="tiles" Name="EmotionTiles" ItemsSource="{Binding Emotions}" SelectedItem="{Binding SelectedEmotion}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VoiceActingChoice">
                  <StackPanel Width="134" Spacing="2">
                    <TextBlock Classes="tileTitle" Text="{Binding Title}"/>
                    <TextBlock Classes="tileText" Text="{Binding Description}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="card" IsEnabled="{Binding SpeechOn}">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.character.expressiveness.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.character.expressiveness}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Expressiveness}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Expressiveness, StringFormat={}{0:0}%}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.character.pitch.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.character.pitch}"/>
                  <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                          Value="{Binding Pitch}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Pitch, StringFormat={}{0:+0.#;-0.#;0}}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.character.breathiness.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.character.breathiness}"/>
                  <Slider Grid.Column="1" Minimum="-50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Breathiness}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Breathiness, StringFormat={}{0:+0;-0;0}}"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Classes="hint" Text="{DynamicResource voiceacting.character.tip}"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <!-- Wave Voice: the game-like way of talking. -->
      <TabItem Name="WaveTab" Header="{DynamicResource voiceacting.tab.wave}">
        <StackPanel Margin="8,10,8,4" Spacing="10">
          <Border Classes="notice" IsVisible="{Binding !CanSpeak}">
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource voiceacting.nosinger}"/>
          </Border>
          <StackPanel Spacing="10" IsEnabled="{Binding CanSpeak}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2" Margin="0,0,16,0">
                <TextBlock Classes="title" Text="{DynamicResource voiceacting.wave}"/>
                <TextBlock Classes="hint" Text="{DynamicResource voiceacting.wave.desc}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Name="WaveSwitch" IsChecked="{Binding WaveOn}"/>
            </Grid>
            <Border Classes="card" IsEnabled="{Binding WaveOn}">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.jumps.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.jumps}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding Jumps}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Jumps, StringFormat={}±{0:0}}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.bounce.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.bounce}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                          Value="{Binding Bounce}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Bounce, StringFormat={}{0:0.##}}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.height.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.height}"/>
                  <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                          Value="{Binding Height}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Height, StringFormat={}{0:+0.#;-0.#;0}}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,Auto,*,Auto,90" ToolTip.Tip="{DynamicResource voiceacting.wave.size.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.size}"/>
                  <TextBlock Grid.Column="1" Classes="end" Text="{DynamicResource voiceacting.wave.size.tiny}"/>
                  <Slider Grid.Column="2" Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Size}"/>
                  <TextBlock Grid.Column="3" Classes="end" Text="{DynamicResource voiceacting.wave.size.big}"/>
                  <TextBlock Grid.Column="4" Classes="value" Text="{Binding Size, StringFormat={}{0:+0;-0;0}}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.pulse.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.pulse}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Pulse}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Pulse, StringFormat={}{0:0}%}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.pulserate.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.pulserate}"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PulseRates}" SelectedItem="{Binding SelectedPulseRate}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.wave.chop.tip}">
                  <TextBlock Classes="label" Text="{DynamicResource voiceacting.wave.chop}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Choppiness}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Choppiness, StringFormat={}{0:0}%}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                  <Button Content="{DynamicResource voiceacting.wave.newmelody}" Command="{Binding NewMelody}"/>
                  <TextBlock Classes="hint" VerticalAlignment="Center" Text="{DynamicResource voiceacting.wave.newmelody.tip}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="subtitle" Text="{DynamicResource voiceacting.wave.rhythm}"/>
                <TextBlock Classes="hint" Text="{DynamicResource voiceacting.wave.rhythm.desc}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RhythmEighthsButton" Content="{DynamicResource voiceacting.wave.rhythm.8}" Command="{Binding RhythmEighths}"/>
                  <Button Content="{DynamicResource voiceacting.wave.rhythm.16}" Command="{Binding RhythmSixteenths}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <!-- Filter: what the voice plays through. -->
      <TabItem Name="FilterTab" Header="{DynamicResource voiceacting.tab.filter}">
        <StackPanel Margin="8,10,8,4" Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" Margin="0,0,16,0">
              <TextBlock Classes="title" Text="{DynamicResource voiceacting.filter}"/>
              <TextBlock Classes="hint" Text="{DynamicResource voiceacting.filter.desc}"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Name="FilterSwitch" IsChecked="{Binding FilterOn}"/>
          </Grid>
          <ListBox Classes="tiles" Name="FilterTiles" ItemsSource="{Binding FilterPresets}" SelectedItem="{Binding SelectedFilterPreset}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VoiceActingChoice">
                <StackPanel Width="98" Spacing="2">
                  <TextBlock Classes="tileTitle" Text="{Binding Title}"/>
                  <TextBlock Classes="tileText" Text="{Binding Description}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Classes="card" IsEnabled="{Binding FilterOn}">
            <StackPanel>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.rate.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.rate}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SelectedSampleRate}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.adpcm.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.adpcm}"/>
                <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{DynamicResource voiceacting.filter.adpcm.desc}"/>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding Adpcm}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.tv.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.tv}"/>
                <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{DynamicResource voiceacting.filter.tv.desc}"/>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding TvSpeaker}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.reverb.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.reverb}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Reverbs}" SelectedItem="{Binding SelectedReverb}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.reverbamount.tip}"
                    IsEnabled="{Binding HasReverb}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.reverbamount}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding ReverbAmount}"/>
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding ReverbAmount, StringFormat={}{0:0}%}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.mix.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.mix}"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding FilterMix}"/>
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding FilterMix, StringFormat={}{0:0}%}"/>
              </Grid>
              <Grid Classes="row" ColumnDefinitions="170,*,90" ToolTip.Tip="{DynamicResource voiceacting.filter.volume.tip}">
                <TextBlock Classes="label" Text="{DynamicResource voiceacting.filter.volume}"/>
                <Slider Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding FilterVolume}"/>
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding FilterVolume, StringFormat={}{0:+0.#;-0.#;0} dB}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
